              "url": "https://res.cloudinary.com/...",
              "publicId": "eris-cafe/products/...",
              "width": 800,
              "height": 800
            }
          }
        },
        {
          "name": "7.2 Delete Image",
          "method": "DELETE",
          "url": "/api/upload/image/:publicId",
          "auth": false,
          "note": "Replace / with , in publicId (e.g., eris-cafe,products,image_id)",
          "body": null,
          "response": {
            "success": true,
            "message": "Image deleted successfully"
          }
        }
      ]
    },
    "8_SECURITY_MODULE": {
      "description": "Handles JWT authentication and session management",
      "endpoints": [
        {
          "name": "8.1 Register (Token Generation)",
          "method": "POST",
          "url": "/api/auth/register",
          "auth": false,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "name": "New User",
            "email": "newuser@test.com",
            "password": "123456"
          },
          "response": {
            "message": "Registration successful",
            "appToken": "jwt_token_here",
            "user": {}
          }
        },
        {
          "name": "8.2 Login (Token Generation)",
          "method": "POST",
          "url": "/api/auth/login",
          "auth": false,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "email": "user@test.com",
            "password": "123456"
          },
          "response": {
            "message": "Login successful",
            "appToken": "jwt_token_here",
            "user": {}
          }
        },
        {
          "name": "8.3 Token Verification (Get Current User)",
          "method": "GET",
          "url": "/api/auth/me",
          "auth": true,
          "headers": {
            "Authorization": "Bearer YOUR_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "user": {}
          }
        },
        {
          "name": "8.4 Google OAuth with reCAPTCHA",
          "method": "POST",
          "url": "/api/auth/google",
          "auth": false,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "token": "google-access-token",
            "recaptchaToken": "recaptcha-response-token"
          },
          "response": {
            "appToken": "jwt_token_here"
          }
        },
        {
          "name": "8.5 Change Password",
          "method": "PUT",
          "url": "/api/auth/change-password",
          "auth": true,
          "headers": {
            "Authorization": "Bearer YOUR_TOKEN_HERE",
            "Content-Type": "application/json"
          },
          "body": {
            "currentPassword": "123456",
            "newPassword": "newpassword123"
          },
          "response": {
            "success": true,
            "message": "Password changed successfully"
          }
        }
      ]
    },
    "9_EMAIL_NOTIFICATION_MODULE": {
      "description": "Handles email notifications and password reset",
      "endpoints": [
        {
          "name": "9.1 Forgot Password",
          "method": "POST",
          "url": "/api/auth/forgot-password",
          "auth": false,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "email": "user@test.com"
          },
          "note": "Requires SMTP credentials in .env (BREVO_SMTP_USER, BREVO_SMTP_KEY)",
