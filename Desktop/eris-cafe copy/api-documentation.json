{
  "info": {
    "title": "Eris Cafe API Documentation",
    "version": "1.0.0",
    "description": "Complete API documentation for Eris Cafe backend",
    "baseUrl": "http://localhost:4000"
  },
  "authentication": {
    "type": "Bearer Token",
    "header": "Authorization",
    "format": "Bearer <token>",
    "note": "Get token from login response (appToken field)"
  },
  "modules": {
    "1_USER_MODULE": {
      "description": "Handles user registration, authentication, and profile management",
      "endpoints": [
        {
          "name": "2.1.1 Register User",
          "method": "POST",
          "url": "/api/auth/register",
          "auth": false,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "name": "John Doe",
            "email": "john@test.com",
            "password": "123456"
          },
          "response": {
            "message": "Registration successful",
            "appToken": "jwt_token_here",
            "user": {
              "id": "user_id",
              "name": "John Doe",
              "email": "john@test.com",
              "role": "customer"
            }
          }
        },
        {
          "name": "2.1.2 Get User Details",
          "method": "GET",
          "url": "/api/auth/me",
          "auth": true,
          "headers": {
            "Authorization": "Bearer YOUR_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "user": {
              "id": "user_id",
              "name": "John Doe",
              "email": "john@test.com",
              "role": "customer"
            }
          }
        },
        {
          "name": "2.1.3 Get All Users (Admin)",
          "method": "GET",
          "url": "/api/admin/users",
          "auth": true,
          "requiresAdmin": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "data": []
          }
        },
        {
          "name": "2.1.4 Update User Details",
          "method": "PUT",
          "url": "/api/auth/update-profile",
          "auth": true,
          "headers": {
            "Authorization": "Bearer YOUR_TOKEN_HERE",
            "Content-Type": "application/json"
          },
          "body": {
            "name": "Updated Name",
            "email": "john@test.com",
            "phone": "09123456789",
            "address": "123 Main St, Manila",
            "bio": "Coffee lover"
          },
          "response": {
            "success": true,
            "message": "Profile updated successfully",
            "appToken": "new_jwt_token",
            "user": {}
          }
        },
        {
          "name": "2.1.5 Delete User (Admin)",
          "method": "DELETE",
          "url": "/api/admin/users/:userId",
          "auth": true,
          "requiresAdmin": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE",
            "Content-Type": "application/json"
          },
          "body": {
            "adminPassword": "admin123"
          },
          "response": {
            "success": true,
            "message": "User deleted successfully"
          }
        }
      ]
    },
    "2_ADMIN_MODULE": {
      "description": "Handles admin account management and access control",
      "endpoints": [
        {
          "name": "2.2.1 Create Admin Account",
          "method": "POST",
          "url": "/api/admin/users/add",
          "auth": true,
          "requiresAdmin": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE",
            "Content-Type": "application/json"
          },
          "body": {
            "name": "New Staff",
            "email": "staff@eriscafe.com",
            "password": "staff123",
            "role": "staff",
            "adminPassword": "admin123"
          },
          "note": "role can be: admin, owner, staff, customer",
          "response": {
            "success": true,
            "message": "User created successfully",
            "data": {}
          }
        },
        {
          "name": "2.2.2 Login Admin",
          "method": "POST",
          "url": "/api/auth/login",
          "auth": false,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "email": "admin@eriscafe.com",
            "password": "admin123"
          },
          "response": {
            "message": "Login successful",
            "appToken": "jwt_token_here",
            "user": {
              "id": "admin_id",
              "name": "Admin User",
              "email": "admin@eriscafe.com",
              "role": "admin"
            }
          }
        },
        {
          "name": "2.2.3 Get Admin Profile",
          "method": "GET",
          "url": "/api/auth/me",
          "auth": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "user": {
              "id": "admin_id",
              "name": "Admin User",
              "email": "admin@eriscafe.com",
              "role": "admin"
            }
          }
        },
        {
          "name": "2.2.4 Check Admin Access (Dashboard Stats)",
          "method": "GET",
          "url": "/api/admin/stats",
          "auth": true,
          "requiresAdmin": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "data": {
              "totalUsers": 13,
              "totalOrders": 25,
              "totalReservations": 19,
              "pendingOrders": 7,
              "confirmedReservations": 6,
              "totalRevenue": null
            }
          }
        },
        {
          "name": "2.2.5 Update User Role",
          "method": "PUT",
          "url": "/api/admin/users/:userId/role",
          "auth": true,
          "requiresAdmin": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE",
            "Content-Type": "application/json"
          },
          "body": {
            "role": "staff",
            "adminPassword": "admin123"
          },
          "response": {
            "success": true,
            "message": "User role updated successfully",
            "data": {}
          }
        },
        {
          "name": "2.2.6 Get Login Logs",
          "method": "GET",
          "url": "/api/admin/login-logs",
          "auth": true,
          "requiresAdmin": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE"
          },
          "queryParams": {
            "role": "admin|customer|staff (optional)",
            "status": "success|failed (optional)",
            "limit": "100 (optional)"
          },
          "body": null,
          "response": {
            "success": true,
            "data": {
              "logs": [],
              "stats": {
                "totalLogins": 0,
                "successfulLogins": 0,
                "failedLogins": 0,
                "activeUsers": 0
              }
            }
          }
        },
        {
          "name": "2.2.7 Get Role Permissions",
          "method": "GET",
          "url": "/api/admin/role-permissions",
          "auth": true,
          "requiresAdmin": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "data": []
          }
        }
      ]
    },
    "3_ORDER_MODULE": {
      "description": "Handles customer orders, order status, and order history",
      "endpoints": [
        {
          "name": "3.1 Create Order",
          "method": "POST",
          "url": "/api/orders/create",
          "auth": true,
          "headers": {
            "Authorization": "Bearer USER_TOKEN_HERE",
            "Content-Type": "application/json"
          },
          "body": {
            "items": [
              {
                "productId": "PRODUCT_ID_HERE",
                "name": "Espresso",
                "price": 120,
                "quantity": 2,
                "size": "Medium",
                "temperature": "Hot",
                "image": "https://example.com/image.jpg"
              }
            ],
            "totalPrice": 240,
            "deliveryAddress": "123 Main St, Manila",
            "paymentMethod": "cod",
            "customerInfo": {
              "name": "John Doe",
              "email": "john@test.com",
              "phone": "09123456789",
              "address": "123 Main St, Manila"
            }
          },
          "response": {
            "success": true,
            "message": "Order placed successfully. Stock updated.",
            "data": {}
          }
        },
        {
          "name": "3.2 Get My Orders",
          "method": "GET",
          "url": "/api/orders/my-orders",
          "auth": true,
          "headers": {
            "Authorization": "Bearer USER_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "data": []
          }
        },
        {
          "name": "3.3 Get Single Order",
          "method": "GET",
          "url": "/api/orders/:orderId",
          "auth": true,
          "headers": {
            "Authorization": "Bearer USER_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "data": {}
          }
        },
        {
          "name": "3.4 Update Order Status (Admin)",
          "method": "PATCH",
          "url": "/api/orders/:orderId/status",
          "auth": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE",
            "Content-Type": "application/json"
          },
          "body": {
            "status": "confirmed"
          },
          "validStatuses": ["pending", "confirmed", "preparing", "ready", "completed", "cancelled"],
          "response": {
            "success": true,
            "message": "Order status updated successfully",
            "data": {}
          }
        },
        {
          "name": "3.5 Cancel Order",
          "method": "DELETE",
          "url": "/api/orders/:orderId",
          "auth": true,
          "headers": {
            "Authorization": "Bearer USER_TOKEN_HERE"
          },
          "body": null,
          "response": {
            "success": true,
            "message": "Order cancelled successfully and stock restored",
            "data": {}
          }
        },
        {
          "name": "3.6 Get All Orders (Admin)",
          "method": "GET",
          "url": "/api/admin/orders",
          "auth": true,
          "requiresAdmin": true,
          "headers": {
            "Authorization": "Bearer ADMIN_TOKEN_HERE"
          },
          "queryParams": {
            "page": "1 (optional)",
            "limit": "20 (optional)"
          },
          "body": null,
          "response": {
            "success": true,
            "data": [],
            "pagination": {
              "page": 1,
              "limit": 20,
              "total": 0,
              "pages": 0
            }
          }
        }
      ]
    },
