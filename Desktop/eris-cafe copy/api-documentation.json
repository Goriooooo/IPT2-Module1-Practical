    "7_FILE_STORAGE_MODULE": {
      "description": "Handles image uploads via Cloudinary",
      "endpoints": [
        {
          "name": "7.1 Upload Image",
          "method": "POST",
          "url": "/api/upload/image",
          "auth": false,
          "headers": {
            "Content-Type": "multipart/form-data"
          },
          "body": {
            "image": "<file>"
          },
          "note": "Use form-data with file field named 'image'",
